# Copy this file to .env and fill in the values. .env is gitignored.

# The number bookings and chats go to. Local (0821234567), spaced
# (082 123 4567) or international (+27821234567) all work. Required.
VITE_WHATSAPP_NUMBER=

# Web3Forms access key — get one free at https://web3forms.com by entering the
# address bookings should land in. Leave empty to fall back to the WhatsApp
# handoff, where the customer sends the booking themselves. Optional.
VITE_WEB3FORMS_ACCESS_KEY=

# hCaptcha site key for the booking form's spam check. The value below is
# Web3Forms' shared key for free plans. Leave empty to switch the check off.
# It must ALSO be enabled in the Web3Forms dashboard, or the token is never
# actually verified.
VITE_HCAPTCHA_SITEKEY=
